{
  "name": "skillsphere",
  "version": "1.0.0",
  "description": "SkillSphere - Employee Skill Matrix Management System built with SAPUI5/Fiori",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.0.0"
  },
  "dependencies": {
    "@cap-js/hana": "^2.7.0",
    "@sap-cloud-sdk/connectivity": "^3.9.0",
    "@sap-cloud-sdk/http-client": "^3.9.0",
    "@sap-cloud-sdk/util": "^3.9.0",
    "@sap/cds": "^9.8.0",
    "@sap/cds-dk": "^9.8.0",
    "@sap/xssec": "^4",
    "axios": "^1.13.2",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.0.0",
    "@eslint/js": "^9.22.0",
    "@sap-ux/eslint-plugin-fiori-tools": "^0.4.0",
    "@sap/ux-ui5-tooling": "1",
    "@sapui5/types": "~1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@ui5/cli": "^4.0.33",
    "concurrently": "^8.2.2",
    "eslint": "^9.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ui5-tooling-transpile": "^3.3.7"
  },
  "scripts": {
    "start": "cds watch",
    "start-ui": "fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "start-with-ui": "concurrently \"npm run start\" \"npm run start-ui\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "cds build --production",
    "build:ui": "cd webapp && npm run build:ui",
    "deploy": "cds deploy --to sqlite",
    "deploy:hana": "cds deploy --to hana",
    "lint": "eslint ./",
    "ts-typecheck": "tsc --noEmit",
    "prestart": "npm run ts-typecheck",
    "start-noflp": "fiori run --open \"/index.html?sap-ui-xx-viewCache=false\"",
    "int-test": "fiori run --open \"test/integration/opaTests.qunit.html\"",
    "start-variants-management": "fiori run --open \"/preview.html#app-preview\"",
    "unit-test": "fiori run --open \"test/unit/unitTests.qunit.html\"",
    "undeploy": "cf undeploy skillsphere --delete-services --delete-service-keys"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "model": [
          "db",
          "srv"
        ]
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": "xsuaa"
      }
    }
  }
}
