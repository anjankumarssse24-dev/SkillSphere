{
  "_version": "1.76.0",
  "sap.app": {
    "id": "skillsphere",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": ["en"],
      "fallbackLocale": "en"
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/api/v1/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "skillsphere-display": {
          "semanticObject": "skillsphere",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.6",
      "toolsId": "fd101b39-cbcf-40fd-9970-2632c49b7ae7"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "skillsphere"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.140.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.table": {},
        "sap.viz": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto",
          "updateGroupId": "updateGroup"
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "skillsphere.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        },
        {
          "uri": "css/responsive.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "skillsphere.view",
        "async": true
      },
      "routes": [
        {
          "name": "Landing",
          "pattern": "",
          "target": ["TargetLanding"]
        },
        {
          "name": "firstTimeSetup",
          "pattern": "first-time-setup",
          "target": ["TargetFirstTimeSetup"]
        },
        {
          "name": "EmployeeLogin",
          "pattern": "employee-login",
          "target": ["TargetEmployeeLogin"]
        },
        {
          "name": "ManagerLogin",
          "pattern": "manager-login",
          "target": ["TargetManagerLogin"]
        },
        {
          "name": "SeniorManagerLogin",
          "pattern": "senior-manager-login",
          "target": ["TargetSeniorManagerLogin"]
        },
        {
          "name": "EmployeeDashboard",
          "pattern": "employee-dashboard/{employeeId}",
          "target": ["TargetEmployeeDashboard"]
        },
        {
          "name": "ManagerDashboard",
          "pattern": "manager-dashboard/{managerId}:?query:",
          "target": ["TargetManagerDashboard"]
        },
        {
          "name": "SeniorManagerDashboard",
          "pattern": "senior-manager-dashboard/{seniorManagerId}",
          "target": ["TargetSeniorManagerDashboard"]
        },
        {
          "name": "SeniorManagerWorkOverview",
          "pattern": "senior-manager-work-overview/{seniorManagerId}",
          "target": ["TargetSeniorManagerWorkOverview"]
        },
        {
          "name": "ManagerWorkOverview",
          "pattern": "manager-work-overview/{managerId}",
          "target": ["TargetManagerWorkOverview"]
        },
        {
          "name": "ManagerTeamView",
          "pattern": "manager-team-view/{managerId}/{seniorManagerId}:?query:",
          "target": ["TargetManagerTeamView"]
        }
      ],
      "targets": {
        "TargetLanding": {
          "id": "Landing",
          "name": "Landing"
        },
        "TargetFirstTimeSetup": {
          "id": "FirstTimeSetup",
          "name": "FirstTimeSetup"
        },
        "TargetEmployeeLogin": {
          "id": "EmployeeLogin",
          "name": "EmployeeLogin"
        },
        "TargetManagerLogin": {
          "id": "ManagerLogin",
          "name": "ManagerLogin"
        },
        "TargetSeniorManagerLogin": {
          "id": "SeniorManagerLogin",
          "name": "SeniorManagerLogin"
        },
        "TargetEmployeeDashboard": {
          "id": "EmployeeDashboard",
          "name": "EmployeeDashboard"
        },
        "TargetManagerDashboard": {
          "id": "ManagerDashboard",
          "name": "ManagerDashboard"
        },
        "TargetSeniorManagerDashboard": {
          "id": "SeniorManagerDashboard",
          "name": "SeniorManagerDashboard"
        },
        "TargetSeniorManagerWorkOverview": {
          "id": "SeniorManagerWorkOverview",
          "name": "SeniorManagerWorkOverview"
        },
        "TargetManagerWorkOverview": {
          "id": "ManagerWorkOverview",
          "name": "ManagerWorkOverview"
        },
        "TargetManagerTeamView": {
          "id": "ManagerTeamView",
          "name": "ManagerTeamView"
        }
      }
    },
    "rootView": {
      "viewName": "skillsphere.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
