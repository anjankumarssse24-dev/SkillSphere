<mvc:View
    controllerName="skillsphere.controller.Landing"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <m:Page id="landingMainPage" title="SkillSphere - Employee Skill Matrix" class="sapUiResponsiveContentPadding">
        <m:content>
            <m:VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTop">
                <!-- Header -->
                <m:Title text="Welcome to SkillSphere" level="H1" class="sapUiLargeMarginBottom"/>
                <m:Text text="Manage your skills and projects efficiently" class="sapUiMediumMarginBottom" textAlign="Center"/>

                <m:Panel
                    width="920px"
                    backgroundDesign="Solid"
                    visible="{access>/showUnauthorized}"
                    class="sapUiMediumMarginTop sapUiMediumMarginBottom">
                    <m:content>
                        <m:VBox class="sapUiMediumMargin">
                            <m:Title text="Access Pending" level="H4" class="sapUiTinyMarginBottom"/>
                            <m:Text text="{access>/message}" class="sapUiTinyMarginBottom"/>
                            <m:Text text="Signed in as: {access>/email}" class="sapUiTinyMarginBottom"/>
                            <m:Text text="{access>/contact}"/>
                        </m:VBox>
                    </m:content>
                </m:Panel>
                
                <!-- Main Panels -->
                <m:FlexBox wrap="Wrap" justifyContent="Center" alignItems="Start" class="sapUiLargeMarginTop">
                    <m:Panel class="skillSphereCard" width="360px" headerText="Local Login" backgroundDesign="Solid" visible="{appConfig>/isLocalMode}">
                        <m:content>
                            <m:VBox alignItems="Stretch" class="sapUiMediumMargin">
                                <m:Title text="Choose Test Role" level="H3" textAlign="Center" class="sapUiSmallMarginBottom"/>
                                <m:Text text="Local mode is enabled. Use the dedicated login screen for one of the configured test users." textAlign="Center" class="sapUiMediumMarginBottom"/>
                                <m:MessageStrip text="Employee: I770144 / password123&#10;Manager: MGR003 / manager123&#10;Senior Manager: SMGR01 / manager123" type="Information" showIcon="true" class="sapUiMediumMarginBottom"/>
                                <m:Button text="Employee Login" type="Emphasized" icon="sap-icon://employee" class="sapUiSmallMarginBottom" press="onEmployeeLoginPress"/>
                                <m:Button text="Manager Login" type="Emphasized" icon="sap-icon://manager" class="sapUiSmallMarginBottom" press="onManagerLoginPress"/>
                                <m:Button text="Senior Manager Login" type="Emphasized" icon="sap-icon://management-review" press="onSeniorManagerLoginPress"/>
                            </m:VBox>
                        </m:content>
                    </m:Panel>
                    
                    <!-- Registration Panel -->
                    <m:Panel class="skillSphereCard" width="300px" headerText="Registration" backgroundDesign="Solid" visible="{= !${appConfig>/isLocalMode} }">
                        <m:content>
                            <m:VBox alignItems="Center" class="sapUiMediumMargin">
                                <core:Icon src="sap-icon://add-employee" size="4rem" color="#0070f2" class="sapUiMediumMarginBottom"/>
                                <m:Title text="Create Account" level="H3" textAlign="Center" class="sapUiSmallMarginBottom"/>
                                <m:Text text="Register as Employee or Manager" textAlign="Center" class="sapUiMediumMarginBottom"/>
                                
                                <!-- Single Registration Button -->
                                <m:Button 
                                    id="landingRegisterBtn"
                                    text="Register"
                                    type="Emphasized"
                                    icon="sap-icon://add-employee"
                                    width="100%"
                                    press="onRegisterPress"/>
                                    
                            </m:VBox>
                        </m:content>
                    </m:Panel>
                    
                </m:FlexBox>
            </m:VBox>
        </m:content>
    </m:Page>

    <!-- Manager Role Selection Dialog -->
    <m:Dialog id="landingManagerRoleDialog" title="Select Manager Role" class="sapUiContentPadding" contentWidth="400px">
        <m:content>
            <m:VBox alignItems="Center" class="sapUiLargeMargin">
                <m:Text text="Please select your management level:" class="sapUiMediumMarginBottom" textAlign="Center"/>
                
                <!-- Manager Option -->
                <m:Button 
                    text="Login as Manager"
                    icon="sap-icon://manager"
                    type="Emphasized"
                    width="100%"
                    class="sapUiMediumMarginBottom"
                    press="onSelectManagerRole"/>
                
                <!-- Senior Manager Option -->
                <m:Button 
                    text="Login as Senior Manager / VP"
                    icon="sap-icon://management-review"
                    type="Emphasized"
                    width="100%"
                    class="sapUiMediumMarginBottom"
                    press="onSelectSeniorManagerRole"/>
                
            </m:VBox>
        </m:content>
        <m:buttons>
            <m:Button text="Cancel" press="onCloseManagerRoleDialog"/>
        </m:buttons>
    </m:Dialog>

    <!-- Registration Dialog -->
    <m:Dialog id="landingRegistrationDialog" title="Register New User" class="sapUiContentPadding" contentWidth="600px" contentHeight="80%">
        <m:content>
            <m:VBox class="sapUiMediumMargin">
                <!-- Role Selection First -->
                <m:Label text="Register as:" required="true" class="sapUiSmallMarginBottom"/>
                <m:SegmentedButton id="landingRegRoleSegmented" selectedKey="Employee" selectionChange="onRoleChange" class="sapUiLargeMarginBottom">
                    <m:items>
                        <m:SegmentedButtonItem key="Employee" text="Employee" icon="sap-icon://employee"/>
                        <m:SegmentedButtonItem key="Manager" text="Manager" icon="sap-icon://manager"/>
                    </m:items>
                </m:SegmentedButton>

                <!-- Basic Information -->
                <m:Title text="Basic Information" level="H4" class="sapUiSmallMarginBottom"/>
                
                <!-- Employee ID First -->
                <m:VBox id="landingEmployeeIdSection" visible="true">
                    <m:Label text="Employee ID:" required="true" class="sapUiSmallMarginBottom"/>
                    <m:Input id="landingRegEmployeeId" placeholder="e.g., I770144" class="sapUiMediumMarginBottom" required="true"/>
                </m:VBox>
                
                <m:Label text="Employee Name:" required="true" class="sapUiSmallMarginBottom"/>
                <m:Input id="landingRegName" placeholder="Enter your name" class="sapUiMediumMarginBottom" required="true"/>
                
                <m:Label text="Email:" required="true" class="sapUiSmallMarginBottom"/>
                <m:Input id="landingRegEmail" placeholder="Enter your email" type="Email" class="sapUiMediumMarginBottom" required="true"/>
                
                <!-- Experience Field -->
                <m:Label text="Experience (Years):" required="true" class="sapUiSmallMarginBottom"/>
                <m:StepInput id="landingRegExperience" value="0" min="0" max="50" step="1" class="sapUiMediumMarginBottom" required="true"/>
                
                <m:Label text="Team:" required="true" class="sapUiSmallMarginBottom"/>
                <m:Select id="landingRegTeam" class="sapUiMediumMarginBottom" required="true">
                    <core:Item key="S4HANA" text="SAP S/4HANA"/>
                    <core:Item key="SuccessFactors" text="SAP SuccessFactors"/>
                    <core:Item key="CIS" text="Customer Innovation Service"/>
                    <core:Item key="Ariba" text="SAP Ariba"/>
                    <core:Item key="BTP" text="SAP Business Technology Platform"/>
                    <core:Item key="DataScience" text="Data Science"/>
                </m:Select>
                
                <m:Label text="Sub Team:" required="true" class="sapUiSmallMarginBottom"/>
                <m:Select id="landingRegSubTeam" class="sapUiMediumMarginBottom" required="true">
                    <core:Item key="Team1" text="Team1"/>
                    <core:Item key="Team2" text="Team2"/>
                    <core:Item key="Team3" text="Team3"/>
                    <core:Item key="Team4" text="Team4"/>
                    <core:Item key="Team5" text="Team5"/>
                    <core:Item key="Team6" text="Team6"/>
                    <core:Item key="Team7" text="Team7"/>
                    <core:Item key="Team8" text="Team8"/>
                </m:Select>

                <!-- Employee Specific Fields -->
                <m:VBox id="landingEmployeeSpecificFields" visible="true">
                    <m:Label text="Manager:" required="true" class="sapUiSmallMarginBottom"/>
                    <m:Select id="landingRegManager" class="sapUiMediumMarginBottom" required="true" items="{managers>/managers}">
                        <core:Item key="{managers>managerId}" text="{managers>name} ({managers>team} - {managers>specialization})"/>
                    </m:Select>
                </m:VBox>

                <!-- Manager Specific Fields -->
                <m:VBox id="landingManagerSpecificFields" visible="false">
                    <m:Label text="Management Area:" required="true" class="sapUiSmallMarginBottom"/>
                    <m:Input id="landingRegManagementArea" placeholder="e.g., S4HANA Development, Analytics Team" class="sapUiMediumMarginBottom"/>
                    
                    <m:Label text="Years of Management Experience:" required="true" class="sapUiSmallMarginBottom"/>
                    <m:StepInput id="landingRegManagerExperience" value="0" min="0" max="50" step="1" class="sapUiMediumMarginBottom"/>
                </m:VBox>

            </m:VBox>
        </m:content>
        <m:buttons>
            <m:Button text="Register" type="Emphasized" icon="sap-icon://save" press="onRegisterUser"/>
            <m:Button text="Cancel" press="onCloseRegisterDialog"/>
        </m:buttons>
    </m:Dialog>

</mvc:View>