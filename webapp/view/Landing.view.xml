<mvc:View
    controllerName="skillsphere.controller.Landing"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:f="sap.f">

    <m:Page id="landingMainPage" title="SkillSphere - Employee Skill Matrix" class="sapUiResponsiveContentPadding">
        <m:content>
            <m:VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTop">
                <!-- Header -->
                <m:Title text="Welcome to SkillSphere" level="H1" class="sapUiLargeMarginBottom"/>
                <m:Text text="Manage your skills and projects efficiently" class="sapUiMediumMarginBottom" textAlign="Center"/>

                <m:Panel
                    width="920px"
                    backgroundDesign="Solid"
                    visible="{access>/showUnauthorized}"
                    class="sapUiMediumMarginTop sapUiMediumMarginBottom">
                    <m:content>
                        <m:VBox class="sapUiMediumMargin">
                            <m:Title text="Access Pending" level="H4" class="sapUiTinyMarginBottom"/>
                            <m:Text text="{access>/message}" class="sapUiTinyMarginBottom"/>
                            <m:Text text="Signed in as: {access>/email}" class="sapUiTinyMarginBottom"/>
                            <m:Text text="{access>/contact}"/>
                        </m:VBox>
                    </m:content>
                </m:Panel>
                
                <!-- Main Panels -->
                <m:FlexBox wrap="Wrap" justifyContent="Center" alignItems="Start" class="sapUiLargeMarginTop">
                    <m:Panel class="skillSphereCard" width="360px" headerText="Local Login" backgroundDesign="Solid" visible="{appConfig>/isLocalMode}">
                        <m:content>
                            <m:VBox alignItems="Stretch" class="sapUiMediumMargin">
                                <m:Title text="Choose Test Role" level="H3" textAlign="Center" class="sapUiSmallMarginBottom"/>
                                <m:Text text="Local mode is enabled. Use the dedicated login screen for one of the configured test users." textAlign="Center" class="sapUiMediumMarginBottom"/>
                                <m:MessageStrip text="Employee: I770144 / password123&#10;Manager: MGR003 / manager123&#10;Senior Manager: SMGR01 / manager123" type="Information" showIcon="true" class="sapUiMediumMarginBottom"/>
                                <m:Button text="Employee Login" type="Emphasized" icon="sap-icon://employee" class="sapUiSmallMarginBottom" press="onEmployeeLoginPress"/>
                                <m:Button text="Manager Login" type="Emphasized" icon="sap-icon://manager" class="sapUiSmallMarginBottom" press="onManagerLoginPress"/>
                                <m:Button text="Senior Manager Login" type="Emphasized" icon="sap-icon://management-review" press="onSeniorManagerLoginPress"/>
                            </m:VBox>
                        </m:content>
                    </m:Panel>
                </m:FlexBox>
            </m:VBox>
        </m:content>
    </m:Page>
</mvc:View>

