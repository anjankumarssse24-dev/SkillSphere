<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        contentWidth="600px">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Edit Project"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://decline" press="onCloseEditMasterProjectDialog" tooltip="Close"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="Project Name:" required="true" />
                <Input
                    value="{editMasterProject>/projectName}"
                    placeholder="Enter project name" />

                <Label text="Technology / Tech Stack:" class="sapUiSmallMarginTop" required="true"/>
                <ComboBox
                    selectedKey="{editMasterProject>/technology}"
                    placeholder="Select primary technology"
                    width="100%">
                    <core:Item key="S4" text="S4"/>
                    <core:Item key="BTP" text="BTP"/>
                    <core:Item key="AI" text="AI"/>
                    <core:Item key="S4+AI" text="S4+AI"/>
                    <core:Item key="BTP+AI" text="BTP+AI"/>
                    <core:Item key="S4+BTP+AI" text="S4+BTP+AI"/>
                </ComboBox>

                <Label text="Start Date:" class="sapUiSmallMarginTop"/>
                <DatePicker
                    value="{editMasterProject>/startDate}"
                    placeholder="Select start date"
                    displayFormat="yyyy-MM-dd"/>

                <Label text="End Date:" class="sapUiSmallMarginTop"/>
                <DatePicker
                    value="{editMasterProject>/endDate}"
                    placeholder="Select end date"
                    displayFormat="yyyy-MM-dd"/>

                <Label text="Status:" class="sapUiSmallMarginTop"/>
                <Select selectedKey="{editMasterProject>/status}" width="100%">
                    <core:Item key="Active" text="Active"/>
                    <core:Item key="Completed" text="Completed"/>
                    <core:Item key="On Hold" text="On Hold"/>
                </Select>

                <Label text="Description:" class="sapUiSmallMarginTop"/>
                <TextArea
                    value="{editMasterProject>/description}"
                    rows="3"
                    width="100%"
                    placeholder="Enter project description" />

                <Label text="Project Manager:" class="sapUiSmallMarginTop" required="true"/>
                <Input
                    value="{editMasterProject>/projectManager}"
                    placeholder="Enter project manager name"
                    width="100%"/>

                <Label text="Project Creator:" class="sapUiSmallMarginTop"/>
                <Input
                    value="{editMasterProject>/projectCreator}"
                    editable="false"
                    width="100%"/>

                <Label text="Region:" class="sapUiSmallMarginTop" required="true"/>
                <Select selectedKey="{editMasterProject>/region}" width="100%">
                    <core:Item key="APAC" text="APAC"/>
                    <core:Item key="EMEA" text="EMEA"/>
                    <core:Item key="AMERICAS" text="AMERICAS"/>
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Save Changes"
                type="Emphasized"
                press="onSaveEditMasterProject" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCloseEditMasterProjectDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
