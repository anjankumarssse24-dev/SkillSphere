<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="availableEmployeesDialog"
        title="{availableEmployeesDialog>/title}"
        contentWidth="600px"
        contentHeight="500px"
        resizable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <Text text="{availableEmployeesDialog>/subtitle}" class="sapUiTinyMarginBottom"/>
                <Table
                    items="{availableEmployeesDialog>/employees}"
                    mode="None">
                    <columns>
                        <Column width="12em"><Text text="Employee ID"/></Column>
                        <Column><Text text="Employee Name"/></Column>
                        <Column width="15em"><Text text="Project End Date"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <Text text="{availableEmployeesDialog>employeeId}"/>
                            <Text text="{availableEmployeesDialog>name}"/>
                            <Text text="{availableEmployeesDialog>projectEndDate}"/>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button text="Close" press="onCloseAvailableEmployeesDialog"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
