<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        contentWidth="560px">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="{masterWorkItemEditor>/dialogTitle}"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://decline" press="onCloseMasterWorkItemDialog" tooltip="Close"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="Type" class="sapUiTinyMarginBottom"/>
                <Input value="{masterWorkItemEditor>/type}" editable="false" class="sapUiMediumMarginBottom"/>

                <Label text="Name" required="true" class="sapUiTinyMarginBottom"/>
                <Input value="{masterWorkItemEditor>/name}" placeholder="Enter name" class="sapUiMediumMarginBottom"/>

                <Label text="Description" class="sapUiTinyMarginBottom"/>
                <TextArea value="{masterWorkItemEditor>/description}" rows="3" class="sapUiMediumMarginBottom"/>

                <Label text="Creator" class="sapUiTinyMarginBottom"/>
                <Input value="{masterWorkItemEditor>/creatorName}" editable="false" class="sapUiMediumMarginBottom"/>

                <Label text="Start Date" class="sapUiTinyMarginBottom"/>
                <DatePicker value="{masterWorkItemEditor>/startDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="100%" class="sapUiMediumMarginBottom"/>

                <Label text="End Date" class="sapUiTinyMarginBottom"/>
                <DatePicker value="{masterWorkItemEditor>/endDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="100%" class="sapUiMediumMarginBottom"/>

                <Label text="Status" class="sapUiTinyMarginBottom"/>
                <Select selectedKey="{masterWorkItemEditor>/status}" width="100%">
                    <core:Item key="Active" text="Active"/>
                    <core:Item key="Completed" text="Completed"/>
                    <core:Item key="On Hold" text="On Hold"/>
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSaveMasterWorkItem"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseMasterWorkItemDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
