<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        contentWidth="500px">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Assign Yourself to Project (from Master Data)"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://decline" press="onCloseCurrentProjectDialog" tooltip="Close"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- Info Message -->
                <MessageStrip
                    text="Select a project created by your manager from the master data. Project Manager and dates will be auto-filled."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                
                <!-- Project Name -->
                <Label text="Project Name (from Manager's Projects):" required="true" />
                <ComboBox
                    selectedKey="{currentProjectDialog>/projectName}"
                    placeholder="Select project created by manager"
                    width="100%"
                    items="{projectsList>/projects}"
                    selectionChange="onProjectSelected">
                    <core:Item key="{projectsList>projectName}" text="{projectsList>projectName}"/>
                </ComboBox>
                
                <!-- Role -->
                <Label text="Role:" required="true" class="sapUiSmallMarginTop" />
                <Select selectedKey="{currentProjectDialog>/role}" width="100%">
                    <core:Item key="" text="-- Select Role --"/>
                    <core:Item key="Developer" text="Developer"/>
                    <core:Item key="Senior Developer" text="Senior Developer"/>
                    <core:Item key="Architect" text="Architect"/>
                    <core:Item key="Backend Developer" text="Backend Developer"/>
                    <core:Item key="Frontend Developer" text="Frontend Developer"/>
                    <core:Item key="Full Stack Developer" text="Full Stack Developer"/>
                    <core:Item key="AI/ML Engineer" text="AI/ML Engineer"/>
                    <core:Item key="Data Scientist" text="Data Scientist"/>
                    <core:Item key="Data Analyst" text="Data Analyst"/>
                    <core:Item key="DevOps Engineer" text="DevOps Engineer"/>
                    <core:Item key="QA Engineer" text="QA Engineer"/>
                    <core:Item key="Tech Lead" text="Tech Lead"/>
                    <core:Item key="Project Manager" text="Project Manager"/>
                </Select>
                
                <!-- Project Manager -->
                <Label text="Project Manager (from Master Data):" required="true" class="sapUiSmallMarginTop" />
                <ComboBox
                    selectedKey="{currentProjectDialog>/projectManager}"
                    placeholder="Auto-filled from project master data"
                    width="100%"
                    enabled="false"
                    items="{managersList>/managers}">
                    <core:Item key="{managersList>name}" text="{managersList>name}"/>
                </ComboBox>
                
                <!-- Start Date -->
                <Label text="Start Date (Your Assignment):" required="true" class="sapUiSmallMarginTop" />
                <DatePicker
                    value="{currentProjectDialog>/startDate}"
                    placeholder="Auto-filled from project, adjust if needed"
                    displayFormat="MM/dd/yyyy"
                    width="100%"/>
                
                <!-- End Date -->
                <Label text="End Date (Your Assignment):" required="true" class="sapUiSmallMarginTop" />
                <DatePicker
                    value="{currentProjectDialog>/endDate}"
                    placeholder="Auto-filled from project, adjust if needed"
                    displayFormat="MM/dd/yyyy"
                    width="100%"/>
                
                <!-- Utilization Percentage Input -->
                <Label text="Utilization per Day (%):" required="true" class="sapUiSmallMarginTop" />
                <ComboBox
                    selectedKey="{currentProjectDialog>/utilizationPercent}"
                    placeholder="Select utilization percentage"
                    width="100%">
                    <core:Item key="100" text="100% (Full Time)"/>
                    <core:Item key="75" text="75%"/>
                    <core:Item key="50" text="50% (Half Time)"/>
                    <core:Item key="25" text="25%"/>
                </ComboBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press="onSaveCurrentProject" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCloseCurrentProjectDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
