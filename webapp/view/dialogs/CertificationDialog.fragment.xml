<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        title="Add/Edit Certification"
        contentWidth="500px">
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- Certification Name -->
                <Label text="Certification Name:" required="true" />
                <Input
                    value="{certificationDialog>/name}"
                    placeholder="Enter certification name"
                    width="100%"/>
                
                <!-- Certification Code -->
                <Label text="Certification Code:" required="true" class="sapUiSmallMarginTop" />
                <Input
                    value="{certificationDialog>/code}"
                    placeholder="Enter certification code (e.g., C_FIORDEV_22)"
                    width="100%"/>
                
                <!-- Date of Completion -->
                <Label text="Date of Completion:" required="true" class="sapUiSmallMarginTop" />
                <DatePicker
                    value="{certificationDialog>/dateOfCompletion}"
                    placeholder="Select completion date"
                    displayFormat="MM/dd/yyyy"
                    width="100%"/>
                
                <!-- Level -->
                <Label text="Level:" required="true" class="sapUiSmallMarginTop" />
                <Select
                    selectedKey="{certificationDialog>/level}"
                    width="100%">
                    <items>
                        <core:Item key="Foundation" text="Foundation"/>
                        <core:Item key="Associate" text="Associate"/>
                        <core:Item key="Professional" text="Professional"/>
                        <core:Item key="Specialist" text="Specialist"/>
                        <core:Item key="Expert" text="Expert"/>
                    </items>
                </Select>
                
                <!-- Description -->
                <Label text="Description:" class="sapUiSmallMarginTop" />
                <TextArea
                    value="{certificationDialog>/description}"
                    placeholder="Enter certification description"
                    width="100%"
                    rows="4"/>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press="onSaveCertification" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCloseCertificationDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
