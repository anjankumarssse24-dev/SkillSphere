<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        title="Assign to Project/Evaluation"
        contentWidth="550px">
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- Info Message -->
                <MessageStrip
                    text="Select a project or evaluation from master data created by your manager."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                
                <!-- Assignment Type -->
                <Label text="Assignment Type:" required="true" />
                <Select
                    selectedKey="{workAssignment>/isEvaluation}"
                    width="100%"
                    change="onWorkTypeChange">
                    <core:Item key="false" text="Project Assignment"/>
                    <core:Item key="true" text="Evaluation Assignment"/>
                </Select>
                
                <!-- Project Selection -->
                <Label text="{= ${workAssignment>/isEvaluation} === 'true' ? 'Evaluation Project:' : 'Project Name:' }" required="true" class="sapUiSmallMarginTop" />
                <ComboBox
                    selectedKey="{workAssignment>/projectName}"
                    placeholder="Select from master data"
                    width="100%"
                    items="{projectsList>/projects}"
                    selectionChange="onWorkProjectSelected">
                    <core:Item key="{projectsList>projectName}" text="{projectsList>projectName}"/>
                </ComboBox>
                
                <!-- Role -->
                <Label text="Your Role:" required="true" class="sapUiSmallMarginTop" />
                <Select selectedKey="{workAssignment>/role}" width="100%">
                    <core:Item key="" text="-- Select Role --"/>
                    <core:Item key="Developer" text="Developer"/>
                    <core:Item key="Architect" text="Architect"/>
                    <core:Item key="Backend Developer" text="Backend Developer"/>
                    <core:Item key="Frontend Developer" text="Frontend Developer"/>
                    <core:Item key="Full Stack Developer" text="Full Stack Developer"/>
                    <core:Item key="AI/ML Engineer" text="AI/ML Engineer"/>
                    <core:Item key="Data Scientist" text="Data Scientist"/>
                    <core:Item key="Data Analyst" text="Data Analyst"/>
                    <core:Item key="DevOps Engineer" text="DevOps Engineer"/>
                    <core:Item key="QA Engineer" text="QA Engineer"/>
                    <core:Item key="Tech Lead" text="Tech Lead"/>
                    <core:Item key="Project Manager" text="Project Manager"/>
                </Select>
                
                <!-- Project Manager (Read-only) -->
                <Label text="Project Manager:" class="sapUiSmallMarginTop" />
                <Input
                    value="{workAssignment>/projectManager}"
                    enabled="false"
                    placeholder="Auto-filled from master data"
                    width="100%"/>
                
                <!-- Start Date -->
                <Label text="Start Date:" required="true" class="sapUiSmallMarginTop" />
                <DatePicker
                    value="{workAssignment>/startDate}"
                    placeholder="Auto-filled, adjust if needed"
                    displayFormat="MM/dd/yyyy"
                    width="100%"/>
                
                <!-- End Date -->
                <Label text="End Date:" required="true" class="sapUiSmallMarginTop" />
                <DatePicker
                    value="{workAssignment>/endDate}"
                    placeholder="Auto-filled, adjust if needed"
                    displayFormat="MM/dd/yyyy"
                    width="100%"/>
                
                <!-- Allocation -->
                <Label text="Your Allocation (%):" required="true" class="sapUiSmallMarginTop" />
                <ComboBox
                    selectedKey="{workAssignment>/utilizationPercent}"
                    placeholder="Select allocation percentage"
                    width="100%">
                    <core:Item key="100" text="100% (Full Time)"/>
                    <core:Item key="75" text="75%"/>
                    <core:Item key="50" text="50% (Half Time)"/>
                    <core:Item key="25" text="25%"/>
                </ComboBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press="onSaveWorkAssignment" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCloseWorkAssignmentDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
