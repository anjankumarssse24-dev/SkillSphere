<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        contentWidth="600px">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Create New Master Project"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://decline" press="onCloseMasterProjectDialog" tooltip="Close"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="Project Name:" required="true" />
                <Input
                    value="{newMasterProject>/projectName}"
                    placeholder="Enter project name" />

                <Label text="Technology / Tech Stack:" class="sapUiSmallMarginTop" required="true"/>
                <ComboBox
                    selectedKey="{newMasterProject>/technology}"
                    placeholder="Select primary technology"
                    width="100%">
                    <core:Item key="S4" text="S4"/>
                    <core:Item key="BTP" text="BTP"/>
                    <core:Item key="AI" text="AI"/>
                    <core:Item key="S4+AI" text="S4+AI"/>
                    <core:Item key="BTP+AI" text="BTP+AI"/>
                    <core:Item key="S4+BTP+AI" text="S4+BTP+AI"/>
                </ComboBox>

                <Label text="Start Date:" class="sapUiSmallMarginTop" required="true"/>
                <DatePicker
                    value="{newMasterProject>/startDate}"
                    placeholder="Select start date"
                    displayFormat="MM/dd/yyyy"/>

                <Label text="End Date:" class="sapUiSmallMarginTop" required="true"/>
                <DatePicker
                    value="{newMasterProject>/endDate}"
                    placeholder="Select end date"
                    displayFormat="MM/dd/yyyy"/>

                <Label text="Status:" class="sapUiSmallMarginTop"/>
                <Select selectedKey="{newMasterProject>/status}" width="100%">
                    <core:Item key="Active" text="Active"/>
                    <core:Item key="Completed" text="Completed"/>
                    <core:Item key="On Hold" text="On Hold"/>
                </Select>

                <Label text="Description:" class="sapUiSmallMarginTop"/>
                <TextArea
                    value="{newMasterProject>/description}"
                    rows="3"
                    width="100%"
                    placeholder="Enter project description" />

                <Label text="Project Manager:" class="sapUiSmallMarginTop" required="true"/>
                <Input
                    value="{newMasterProject>/projectManager}"
                    placeholder="Enter project manager name"
                    width="100%"/>

                <Label text="Project Creator:" class="sapUiSmallMarginTop" required="true"/>
                <Input
                    value="{newMasterProject>/projectCreator}"
                    editable="false"
                    width="100%"/>

                <Label text="Region:" class="sapUiSmallMarginTop" required="true"/>
                <Select selectedKey="{newMasterProject>/region}" width="100%">
                    <core:Item key="APAC" text="APAC"/>
                    <core:Item key="EMEA" text="EMEA"/>
                    <core:Item key="AMERICAS" text="AMERICAS"/>
                </Select>

                <Label text="Account Executive Manager (AEM):" class="sapUiSmallMarginTop"/>
                <ComboBox
                    selectedKey="{newMasterProject>/accountExecutiveManager}"
                    placeholder="Select AEM (Line Manager)"
                    width="100%">
                    <core:Item key="Sachin Muralidhar Tadse" text="Sachin Muralidhar Tadse"/>
                    <core:Item key="Fazal Ilahi" text="Fazal Ilahi"/>
                    <core:Item key="Deepak" text="Deepak"/>
                    <core:Item key="Abhishek Garg" text="Abhishek Garg"/>
                    <core:Item key="Hemlata Janawa" text="Hemlata Janawa"/>
                    <core:Item key="Pawan Jain" text="Pawan Jain"/>
                    <core:Item key="Puja K" text="Puja K"/>
                    <core:Item key="Agya Pal Singh" text="Agya Pal Singh"/>
                </ComboBox>

                <Label text="Project Orchestrator:" class="sapUiSmallMarginTop"/>
                <Input
                    value="{newMasterProject>/projectOrchestrator}"
                    placeholder="Coordinates frontend-backend integration" />
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Create Project"
                type="Emphasized"
                press="onSaveMasterProject" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCloseMasterProjectDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
