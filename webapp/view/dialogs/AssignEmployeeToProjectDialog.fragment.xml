<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        title="Assign Team Members to Project"
        contentWidth="550px">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Assign Team Members to Project"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://decline" press="onCloseAssignEmployeeDialog" tooltip="Close"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="Project:" class="sapUiTinyMarginBottom"/>
                <Text text="{assignEmployee>/projectName}" class="sapUiMediumMarginBottom sapThemeHighlight-asTextColor"/>
                
                <Label text="Select Team Members:" required="true" class="sapUiSmallMarginTop"/>
                <MultiComboBox
                    id="assignEmployeeMultiCombo"
                    selectedKeys="{assignEmployee>/selectedEmployeeIds}"
                    placeholder="Select one or more employees..."
                    width="100%"
                    items="{assignEmployee>/employees}">
                    <core:Item key="{assignEmployee>employeeId}" text="{assignEmployee>name} ({assignEmployee>employeeId})"/>
                </MultiComboBox>

                <Label text="Role in Project:" class="sapUiSmallMarginTop"/>
                <ComboBox
                    selectedKey="{assignEmployee>/role}"
                    placeholder="Select role"
                    width="100%">
                    <core:Item key="Developer" text="Developer"/>
                    <core:Item key="Senior Developer" text="Senior Developer"/>
                    <core:Item key="Tech Lead" text="Tech Lead"/>
                    <core:Item key="Solution Architect" text="Solution Architect"/>
                    <core:Item key="Team Member" text="Team Member"/>
                    <core:Item key="QA Engineer" text="QA Engineer"/>
                    <core:Item key="DevOps Engineer" text="DevOps Engineer"/>
                    <core:Item key="Data Scientist" text="Data Scientist"/>
                    <core:Item key="Frontend Developer" text="Frontend Developer"/>
                    <core:Item key="Backend Developer" text="Backend Developer"/>
                    <core:Item key="Full Stack Developer" text="Full Stack Developer"/>
                    <core:Item key="AI/ML Engineer" text="AI/ML Engineer"/>
                </ComboBox>

                <Label text="Allocation (%):" class="sapUiSmallMarginTop"/>
                <StepInput
                    value="{assignEmployee>/allocation}"
                    min="1"
                    max="100"
                    step="5"
                    width="100%"/>

                <MessageStrip text="Selected employees will receive this project assignment. You can assign multiple team members at once." 
                              type="Information" 
                              showIcon="true" 
                              class="sapUiSmallMarginTop"/>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Assign"
                type="Emphasized"
                press="onConfirmAssignEmployee" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="onCloseAssignEmployeeDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>