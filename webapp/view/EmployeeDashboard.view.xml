<mvc:View
    controllerName="skillsphere.controller.EmployeeDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap">

    <uxap:ObjectPageLayout id="employeeObjectPage">
        <uxap:headerTitle>
            <uxap:ObjectPageHeader id="employeeHeader" objectTitle="{currentUser>/name}" objectSubtitle="Employee Dashboard">
            </uxap:ObjectPageHeader>
        </uxap:headerTitle>

        <uxap:sections>
            <!-- Profile Section -->
            <uxap:ObjectPageSection id="profileSection" title="Profile Information" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="profileSubSection">
                        <uxap:blocks>
                            <f:Card id="profileCard" class="sapUiMediumMargin" width="94%">
                                <f:content>
                                    <m:VBox id="profileVBox" class="sapUiMediumMargin">
                                        <m:HBox id="profileHBox1" class="sapUiSmallMarginBottom">
                                            <m:Label id="empIdLabel" text="Employee ID: " class="sapUiSmallMarginEnd"/>
                                            <m:Text id="empIdText" text="{currentUser>/id}"/>
                                        </m:HBox>
                                        <m:HBox id="profileHBox2" class="sapUiSmallMarginBottom">
                                            <m:Label id="teamLabel" text="Team: " class="sapUiSmallMarginEnd"/>
                                            <m:Text id="teamText" text="{currentUser>/team}"/>
                                        </m:HBox>
                                        <m:HBox id="profileHBox3" class="sapUiSmallMarginBottom">
                                            <m:Label id="managerLabel" text="Manager: " class="sapUiSmallMarginEnd"/>
                                            <m:Text id="managerText" text="{currentUser>/manager}"/>
                                        </m:HBox>
                                        <m:HBox id="profileHBox4">
                                            <m:Label id="emailLabel" text="Email: " class="sapUiSmallMarginEnd"/>
                                            <m:Text id="emailText" text="{currentUser>/email}"/>
                                        </m:HBox>
                                    </m:VBox>
                                </f:content>
                            </f:Card>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Utilization Management Section -->
            <uxap:ObjectPageSection id="utilizationSection" title="Utilization Management" titleUppercase="false">
                <uxap:subSections>
                    <!-- Unified Work Assignments -->
                    <uxap:ObjectPageSubSection id="currentProjectSubSection" title="My Work &amp; Utilization">
                        <uxap:blocks>
                            <f:Card id="currentProjectCard" class="sapUiMediumMargin" width="96%">
                                <f:content>
                                    <m:VBox id="currentProjectVBox" class="sapUiMediumMargin">
                                        <m:FlexBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                            <m:Title id="currentProjectTitle" text="All Work Assignments" level="H3"/>
                                            <m:ObjectStatus text="Managed by your manager" state="Information"/>
                                        </m:FlexBox>
                                        
                                        <m:Table id="currentProjectTable" 
                                                 items="{currentProjects>/data}" 
                                                 class="sapUiSmallMarginTop"
                                                 growing="true"
                                                 growingThreshold="20">
                                            <m:columns>
                                                <m:Column width="10%">
                                                    <m:Text text="Type"/>
                                                </m:Column>
                                                <m:Column width="10%">
                                                    <m:Text text="Status"/>
                                                </m:Column>
                                                <m:Column width="18%">
                                                    <m:Text text="Name"/>
                                                </m:Column>
                                                <m:Column width="10%">
                                                    <m:Text text="Role"/>
                                                </m:Column>
                                                <m:Column width="12%">
                                                    <m:Text text="Project Manager"/>
                                                </m:Column>
                                                <m:Column width="10%" hAlign="Center">
                                                    <m:Text text="Start Date"/>
                                                </m:Column>
                                                <m:Column width="10%" hAlign="Center">
                                                    <m:Text text="End Date"/>
                                                </m:Column>
                                                <m:Column width="8%" hAlign="Center">
                                                    <m:Text text="Allocation"/>
                                                </m:Column>
                                                <m:Column width="12%" hAlign="Center">
                                                    <m:Text text="Actions"/>
                                                </m:Column>
                                            </m:columns>
                                            <m:items>
                                                <m:ColumnListItem>
                                                    <m:cells>
                                                        <m:ObjectStatus
                                                            text="{currentProjects>type}"
                                                            state="{= ${currentProjects>type} === 'Project' ? 'Success' : ${currentProjects>type} === 'Evaluation' ? 'Warning' : ${currentProjects>type} === 'Initiative' ? 'Information' : ${currentProjects>type} === 'CAIA' ? 'Error' : 'None' }"/>
                                                        <m:ObjectStatus
                                                            text="{path: 'currentProjects>assignmentStatus', formatter: '.formatAssignmentStatusLabel'}"
                                                            state="{path: 'currentProjects>assignmentStatus', formatter: '.formatAssignmentStatusState'}"/>
                                                        <m:Text text="{currentProjects>projectName}"/>
                                                        <m:Text text="{currentProjects>role}"/>
                                                        <m:Text text="{currentProjects>projectManager}"/>
                                                        <m:Text text="{currentProjects>startDate}"/>
                                                        <m:Text text="{currentProjects>endDate}"/>
                                                        <m:Text text="{path: 'currentProjects>utilizationPercent', formatter: '.formatUtilizationPercent'}"/>
                                                        <m:HBox justifyContent="Center" alignItems="Center" class="sapUiTinyMargin">
                                                            <m:Button 
                                                                icon="sap-icon://complete" 
                                                                type="Accept"
                                                                press="onCompleteWork" 
                                                                tooltip="Mark as Completed"
                                                                visible="{= ${currentProjects>assignmentStatus} !== 'Completed' }"
                                                                class="sapUiTinyMarginEnd"/>
                                                            <m:Button 
                                                                icon="sap-icon://edit" 
                                                                press="onEditCurrentProject" 
                                                                tooltip="Edit"
                                                                visible="{= ${currentProjects>assignmentStatus} !== 'Completed' }"
                                                                class="sapUiTinyMarginEnd"/>
                                                            <m:Button 
                                                                icon="sap-icon://delete" 
                                                                type="Reject" 
                                                                press="onDeleteCurrentProject" 
                                                                tooltip="Delete"
                                                                visible="{= ${currentProjects>assignmentStatus} !== 'Completed' }"/>
                                                        </m:HBox>
                                                    </m:cells>
                                                </m:ColumnListItem>
                                            </m:items>
                                        </m:Table>
                                    </m:VBox>
                                </f:content>
                            </f:Card>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Skills Section -->
            <uxap:ObjectPageSection id="skillsSection" title="My Skills" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="skillsSubSection">
                        <uxap:blocks>
                            <m:VBox id="skillsVBox" class="sapUiMediumMargin">
                                <m:Toolbar id="skillsToolbar">
                                    <m:Title id="skillsTitle" text="Skills"/>
                                    <m:ToolbarSpacer id="skillsToolbarSpacer"/>
                                    <m:Button id="addSkillBtn" text="Add Skill" icon="sap-icon://add" type="Emphasized" press="onAddSkill"/>
                                </m:Toolbar>
                                
                                <m:Table id="skillsTable" items="{skills>/skills}" class="sapUiSmallMarginTop">
                                    <m:columns>
                                        <m:Column id="skillNameCol">
                                            <m:Text id="skillNameHeader" text="Skill Name"/>
                                        </m:Column>
                                        <m:Column id="categoryCol">
                                            <m:Text id="categoryHeader" text="Category"/>
                                        </m:Column>
                                        <m:Column id="proficiencyCol">
                                            <m:Text id="proficiencyHeader" text="Proficiency Level"/>
                                        </m:Column>
                                        <m:Column id="yearsCol">
                                            <m:Text id="yearsHeader" text="Years of Experience"/>
                                        </m:Column>
                                        <m:Column id="certificationCol">
                                            <m:Text id="certificationHeader" text="Certification"/>
                                        </m:Column>
                                        <m:Column id="skillActionsCol" width="150px">
                                            <m:Text id="skillActionsHeader" text="Actions"/>
                                        </m:Column>
                                    </m:columns>
                                    <m:items>
                                        <m:ColumnListItem id="skillItem">
                                            <m:Text id="skillNameText" text="{skills>skillName}"/>
                                            <m:Text id="categoryText" text="{skills>category}"/>
                                            <m:ObjectStatus id="proficiencyStatus" text="{skills>proficiencyLevel}" 
                                                state="{path: 'skills>proficiencyLevel', formatter: '.formatProficiencyState'}"/>
                                            <m:Text id="yearsText" text="{skills>yearsExperience}"/>
                                            <m:ObjectStatus id="certificationStatus" text="{skills>certificationStatus}"
                                                state="{path: 'skills>certificationStatus', formatter: '.formatCertificationState'}"/>
                                            <m:HBox id="skillActionsHBox">
                                                <m:Button id="editSkillBtn" icon="sap-icon://edit" press="onEditSkill" tooltip="Edit Skill"/>
                                                <m:Button id="deleteSkillBtn" icon="sap-icon://delete" type="Reject" press="onDeleteSkill" tooltip="Delete Skill"/>
                                            </m:HBox>
                                        </m:ColumnListItem>
                                    </m:items>
                                </m:Table>
                            </m:VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Completed Projects Section -->
            <uxap:ObjectPageSection id="projectsSection" title="My Projects" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="projectsSubSection">
                        <uxap:blocks>
                            <m:VBox id="projectsVBox" class="sapUiMediumMargin">
                                <m:Toolbar id="projectsToolbar">
                                    <m:Title id="projectsTitle" text="Completed Projects"/>
                                    <m:ToolbarSpacer id="projectsToolbarSpacer"/>
                                </m:Toolbar>
                                
                                <m:Table id="projectsTable" items="{completedProjects>/projects}" class="sapUiSmallMarginTop"
                                         noDataText="No completed projects yet">
                                    <m:columns>
                                        <m:Column id="projectTypeCol">
                                            <m:Text id="projectTypeHeader" text="Type"/>
                                        </m:Column>
                                        <m:Column id="projectNameCol">
                                            <m:Text id="projectNameHeader" text="Name"/>
                                        </m:Column>
                                        <m:Column id="roleCol">
                                            <m:Text id="roleHeader" text="Role"/>
                                        </m:Column>
                                        <m:Column id="projectManagerCol">
                                            <m:Text id="projectManagerHeader" text="Project Manager"/>
                                        </m:Column>
                                        <m:Column id="projectStartCol" hAlign="Center">
                                            <m:Text id="projectStartHeader" text="Start Date"/>
                                        </m:Column>
                                        <m:Column id="projectEndCol" hAlign="Center">
                                            <m:Text id="projectEndHeader" text="End Date"/>
                                        </m:Column>
                                        <m:Column id="projectAllocCol" hAlign="Center">
                                            <m:Text id="projectAllocHeader" text="Allocation"/>
                                        </m:Column>
                                    </m:columns>
                                    <m:items>
                                        <m:ColumnListItem id="projectItem">
                                            <m:ObjectStatus
                                                text="{completedProjects>type}"
                                                state="{= ${completedProjects>type} === 'Project' ? 'Success' : ${completedProjects>type} === 'Evaluation' ? 'Warning' : 'Information' }"/>
                                            <m:Text id="projectNameText" text="{completedProjects>projectName}"/>
                                            <m:Text id="roleText" text="{completedProjects>role}"/>
                                            <m:Text id="projectManagerText" text="{completedProjects>projectManager}"/>
                                            <m:Text id="projectStartText" text="{completedProjects>startDate}"/>
                                            <m:Text id="projectEndText" text="{completedProjects>endDate}"/>
                                            <m:Text id="projectAllocText" text="{path: 'completedProjects>utilizationPercent', formatter: '.formatUtilizationPercent'}"/>
                                        </m:ColumnListItem>
                                    </m:items>
                                </m:Table>
                            </m:VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Certifications Section -->
            <uxap:ObjectPageSection id="certificationsSection" title="My Certifications" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="certificationsSubSection">
                        <uxap:blocks>
                            <m:VBox id="certificationsVBox" class="sapUiMediumMargin">
                                <m:Toolbar id="certificationsToolbar">
                                    <m:Title id="certificationsTitle" text="Certifications"/>
                                    <m:ToolbarSpacer id="certificationsToolbarSpacer"/>
                                    <m:Label text="Filter by Year:" class="sapUiSmallMarginEnd"/>
                                    <m:Select id="certYearFilter" width="100px" selectedKey="{certifications>/selectedYear}" change="onCertificationYearFilterChange">
                                        <core:Item key="all" text="All Years"/>
                                        <core:Item key="2026" text="2026"/>
                                        <core:Item key="2025" text="2025"/>
                                    </m:Select>
                                    <m:ToolbarSpacer id="spacer1"/>
                                    <m:Button id="addCertificationBtn" text="Add Certification" icon="sap-icon://add" type="Emphasized" press="onAddCertification"/>
                                </m:Toolbar>
                                
                                <m:Table id="certificationsTable" items="{certifications>/certifications}" class="sapUiSmallMarginTop">
                                    <m:columns>
                                        <m:Column id="certNameCol">
                                            <m:Text id="certNameHeader" text="Certification Name"/>
                                        </m:Column>
                                        <m:Column id="certCodeCol">
                                            <m:Text id="certCodeHeader" text="Certification Code"/>
                                        </m:Column>
                                        <m:Column id="certDateCol">
                                            <m:Text id="certDateHeader" text="Date of Completion"/>
                                        </m:Column>
                                        <m:Column id="certLevelCol">
                                            <m:Text id="certLevelHeader" text="Level"/>
                                        </m:Column>
                                        <m:Column id="certDescCol" minScreenWidth="Desktop" demandPopin="true">
                                            <m:Text id="certDescHeader" text="Description"/>
                                        </m:Column>
                                        <m:Column id="certActionsCol" width="150px">
                                            <m:Text id="certActionsHeader" text="Actions"/>
                                        </m:Column>
                                    </m:columns>
                                    <m:items>
                                        <m:ColumnListItem id="certificationItem">
                                            <m:Text id="certNameText" text="{certifications>name}"/>
                                            <m:Text id="certCodeText" text="{certifications>code}"/>
                                            <m:Text id="certDateText" text="{certifications>dateOfCompletion}"/>
                                            <m:ObjectStatus id="certLevelStatus" text="{certifications>level}" state="Success"/>
                                            <m:Text id="certDescText" text="{certifications>description}"/>
                                            <m:HBox id="certActionsHBox">
                                                <m:Button id="editCertBtn" icon="sap-icon://edit" press="onEditCertification" tooltip="Edit Certification"/>
                                                <m:Button id="deleteCertBtn" icon="sap-icon://delete" type="Reject" press="onDeleteCertification" tooltip="Delete Certification"/>
                                            </m:HBox>
                                        </m:ColumnListItem>
                                    </m:items>
                                </m:Table>
                            </m:VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Employee Profile Management Section -->
            <uxap:ObjectPageSection id="profileManagementSection" title="Profile Management" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="profileManagementSubSection">
                        <uxap:blocks>
                            <f:Card id="profileManagementCard" class="sapUiMediumMargin" width="96%">
                                <f:content>
                                    <m:VBox id="profileManagementVBox" class="sapUiMediumMargin" width="100%">
                                        <m:Title text="View or Update Your Profile" level="H3" class="sapUiMediumMarginBottom"/>
    

                                        <m:VBox visible="{= !${profileUi>/isEditing} }" class="sapUiSmallMarginTop">
                                            <m:Panel headerText="Identity" class="sapUiTinyMarginBottom" backgroundDesign="Translucent">
                                                <m:content>
                                                    <m:VBox class="sapUiSmallMargin">
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Full Name" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/name} ? ${selfProfile>/name} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween"><m:Label text="Email" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/email} ? ${selfProfile>/email} : '* click edit to add *' }"/></m:HBox>
                                                    </m:VBox>
                                                </m:content>
                                            </m:Panel>

                                            <m:Panel headerText="Organization" class="sapUiTinyMarginBottom" backgroundDesign="Translucent">
                                                <m:content>
                                                    <m:VBox class="sapUiSmallMargin">
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Team" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/team} ? ${selfProfile>/team} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Sub-Team" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/subTeam} ? ${selfProfile>/subTeam} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Experience" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/experience} || ${selfProfile>/experience} === 0 ? ${selfProfile>/experience} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween"><m:Label text="Reporting Manager" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/managerName} ? ${selfProfile>/managerName} : '* click edit to add *' }"/></m:HBox>
                                                    </m:VBox>
                                                </m:content>
                                            </m:Panel>

                                            <m:Panel headerText="Professional Profile" class="sapUiTinyMarginBottom" backgroundDesign="Translucent">
                                                <m:content>
                                                    <m:VBox class="sapUiSmallMargin">
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Role" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/professionalRole} ? ${selfProfile>/professionalRole} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Location" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/location} ? ${selfProfile>/location} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="T Level" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/tLevel} ? ${selfProfile>/tLevel} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom"><m:Label text="Grade Level" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/gradeLevel} ? ${selfProfile>/gradeLevel} : '* click edit to add *' }"/></m:HBox>
                                                        <m:HBox justifyContent="SpaceBetween"><m:Label text="Specialization" design="Bold" width="14rem"/><m:Text text="{= ${selfProfile>/specialization} ? ${selfProfile>/specialization} : '* click edit to add *' }"/></m:HBox>
                                                    </m:VBox>
                                                </m:content>
                                            </m:Panel>

                                            <m:FlexBox justifyContent="End" class="sapUiMediumMarginTop" width="100%">
                                                <m:Button text="Edit" type="Emphasized" icon="sap-icon://edit" press="onEditProfile"/>
                                            </m:FlexBox>
                                        </m:VBox>

                                        <m:VBox visible="{profileUi>/isEditing}" class="sapUiSmallMarginTop">
                                            <m:FlexBox direction="Row" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom" width="100%">
                                                <m:VBox width="48%">
                                                    <m:Label text="Full Name" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Input value="{selfProfile>/name}" width="100%" class="sapUiMediumMarginBottom"/>
                                                </m:VBox>
                                                <m:VBox width="48%">
                                                    <m:Label text="Email" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Input value="{selfProfile>/email}" width="100%" class="sapUiMediumMarginBottom"/>
                                                </m:VBox>
                                            </m:FlexBox>

                                            <m:FlexBox direction="Row" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom" width="100%">
                                                <m:VBox width="30%">
                                                    <m:Label text="Team" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Input value="{selfProfile>/team}" width="100%" class="sapUiMediumMarginBottom"/>
                                                </m:VBox>
                                                <m:VBox width="36%">
                                                    <m:Label text="Sub-Team" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Input value="{selfProfile>/subTeam}" width="100%" class="sapUiMediumMarginBottom"/>
                                                </m:VBox>
                                                <m:VBox width="30%">
                                                    <m:Label text="Experience (Years)" class="sapUiTinyMarginBottom"/>
                                                    <m:StepInput value="{selfProfile>/experience}" min="0" max="50" step="0.5" width="100%" class="sapUiMediumMarginBottom"/>
                                                </m:VBox>
                                            </m:FlexBox>

                                            <m:FlexBox direction="Row" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom" width="100%">
                                                <m:VBox width="48%">
                                                    <m:Label text="Reporting Manager" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Select selectedKey="{selfProfile>/managerId}" width="100%" class="sapUiMediumMarginBottom" items="{managersList>/managers}">
                                                        <core:Item key="{managersList>employeeId}" text="{managersList>name} ({managersList>employeeId})"/>
                                                    </m:Select>
                                                </m:VBox>
                                                <m:VBox width="48%">
                                                    <m:Label text="Role" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Select selectedKey="{selfProfile>/professionalRole}" width="100%" class="sapUiMediumMarginBottom">
                                                        <core:Item key="" text="-- Select Role --"/>
                                                        <core:Item key="Developer" text="Developer"/>
                                                        <core:Item key="Architect" text="Architect"/>
                                                        <core:Item key="Backend Developer" text="Backend Developer"/>
                                                        <core:Item key="Frontend Developer" text="Frontend Developer"/>
                                                        <core:Item key="Full Stack Developer" text="Full Stack Developer"/>
                                                        <core:Item key="AI/ML Engineer" text="AI/ML Engineer"/>
                                                        <core:Item key="Data Scientist" text="Data Scientist"/>
                                                        <core:Item key="DevOps Engineer" text="DevOps Engineer"/>
                                                        <core:Item key="QA Engineer" text="QA Engineer"/>
                                                        <core:Item key="Project Manager" text="Project Manager"/>
                                                        <core:Item key="ABAP Developer" text="ABAP Developer"/>
                                                    </m:Select>
                                                </m:VBox>
                                            </m:FlexBox>

                                            <m:FlexBox direction="Row" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom" width="100%">
                                                <m:VBox width="30%">
                                                    <m:Label text="Location" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Select selectedKey="{selfProfile>/location}" width="100%" class="sapUiMediumMarginBottom">
                                                        <core:Item key="" text="-- Select Location --"/>
                                                        <core:Item key="Whitefield, Bangalore" text="Whitefield, Bangalore"/>
                                                        <core:Item key="Devanahalli, Bangalore" text="Devanahalli, Bangalore"/>
                                                        <core:Item key="Gurgaon" text="Gurgaon"/>
                                                    </m:Select>
                                                </m:VBox>
                                                <m:VBox width="30%">
                                                    <m:Label text="T Level" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Select selectedKey="{selfProfile>/tLevel}" width="100%" class="sapUiMediumMarginBottom" change="onTLevelChange">
                                                        <core:Item key="" text="-- Select T Level --"/>
                                                        <core:Item key="T1" text="T1"/>
                                                        <core:Item key="T2" text="T2"/>
                                                        <core:Item key="T3" text="T3"/>
                                                        <core:Item key="T4" text="T4"/>
                                                    </m:Select>
                                                </m:VBox>
                                                <m:VBox width="30%">
                                                    <m:Label text="Grade Level" class="sapUiTinyMarginBottom" required="true"/>
                                                    <m:Select selectedKey="{selfProfile>/gradeLevel}" width="100%" class="sapUiMediumMarginBottom">
                                                        <core:Item key="" text="-- Select Grade Level --"/>
                                                        <core:Item key="L1" text="L1"/>
                                                        <core:Item key="L2" text="L2"/>
                                                        <core:Item key="L3" text="L3"/>
                                                    </m:Select>
                                                </m:VBox>
                                            </m:FlexBox>

                                            <m:VBox width="100%">
                                                <m:Label text="Specialization" class="sapUiTinyMarginBottom" required="true"/>
                                                <m:Input value="{selfProfile>/specialization}" width="100%" class="sapUiMediumMarginBottom"/>
                                            </m:VBox>

                                            <m:FlexBox justifyContent="End" class="sapUiMediumMarginTop" width="100%">
                                                <m:Button text="Cancel" type="Transparent" icon="sap-icon://decline" press="onCancelProfileEdit" class="sapUiTinyMarginEnd"/>
                                                <m:Button text="Save Profile" type="Emphasized" icon="sap-icon://save" press="onSaveProfile"/>
                                            </m:FlexBox>
                                        </m:VBox>
                                    </m:VBox>
                                </f:content>
                            </f:Card>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
 <!-- AI Assistant button hidden until AI Core is configured
    <m:Button
        icon="sap-icon://message-assistant"
        text="AI Assistant"
        type="Emphasized"
        press="onOpenAIAssistant"
        class="aiAssistantFloatingButton"
        tooltip="Open AI Assistant"/>
    -->
    
    <!-- AI Assistant Dialog -->
    <m:Dialog
        id="aiAssistantDialogEmployee"
        title="SkillSphere AI Assistant"
        contentWidth="750px"
        contentHeight="800px"
        class="aiAssistantDialog"
        resizable="true"
        draggable="true">
        
        <m:customHeader>
            <m:Bar>
                <m:contentLeft>
                    <core:Icon src="sap-icon://discussion" size="1.5rem" class="sapUiTinyMarginBegin"/>
                    <m:Title text="AI Assistant" class="sapUiTinyMarginBegin"/>
                </m:contentLeft>
                <m:contentRight>
                    <m:Button icon="sap-icon://decline" press="onCloseAIDialog" tooltip="Close"/>
                </m:contentRight>
            </m:Bar>
        </m:customHeader>
        
        <m:content>
            <m:VBox height="100%" width="100%" class="aiAssistantContent">
                
                <!-- Chat Messages Area -->
                <m:ScrollContainer
                    id="chatContainerEmployee"
                    height="100%"
                    vertical="true"
                    horizontal="false"
                    class="aiChatScrollArea">
                    <m:VBox id="messagesContainerEmployee" width="100%" class="aiMessagesContainer"/>
                </m:ScrollContainer>
                
                <!-- Quick Action Buttons for Employee -->
                <m:HBox justifyContent="Center" class="aiQuickActionsBar">
                    <m:Button 
                        text="My Skills" 
                        icon="sap-icon://learning-assistant"
                        press="onQuickAction"
                        class="sapUiTinyMarginEnd"
                        type="Emphasized"/>
                    <m:Button 
                        text="Training" 
                        icon="sap-icon://course-book"
                        press="onQuickAction"
                        class="sapUiTinyMarginEnd"
                        type="Emphasized"/>
                    <m:Button 
                        text="Projects" 
                        icon="sap-icon://project-definition-triangle"
                        press="onQuickAction"
                        type="Emphasized"/>
                </m:HBox>
            </m:VBox>
        </m:content>

        <m:footer>
            <m:Toolbar class="aiInputBar">
                <m:Button text="Clear Chat" press="onClearChat" icon="sap-icon://refresh"/>
                <m:ToolbarSpacer/>
                <m:Input
                    id="messageInputEmployee"
                    placeholder="Ask me anything..."
                    submit="onSendMessage"
                    class="aiMessageInput aiMessageInputGrow">
                    <m:layoutData>
                        <m:ToolbarLayoutData shrinkable="true" minWidth="12rem" maxWidth="100%"/>
                    </m:layoutData>
                </m:Input>
                <m:Button
                    icon="sap-icon://paper-plane"
                    type="Emphasized"
                    press="onSendMessage"
                    tooltip="Send Message"
                    class="aiSendButton"/>
            </m:Toolbar>
                </m:footer>
        
    </m:Dialog>
</mvc:View>

