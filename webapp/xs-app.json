{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/skillsphere/(.*)$",
      "target": "/odata/v4/skillsphere/$1",
      "destination": "skillsphere-srv-api",
      "authenticationType": "none",
      "csrfProtection": true
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
